[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game/title.gd" id="1_title"]
[ext_resource type="Theme" path="res://art/theme/shop_theme.tres" id="2_theme"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_title")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.065, 0.05, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Rows" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="GameTitle" type="Label" parent="Center/Rows"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 56
text = "Atelier"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Rows"]
layout_mode = 2
text = "A scroll shop where every spell is drawn by hand.  -  Demo"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/Rows"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="PlayButton" type="Button" parent="Center/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"ApproveStamp"
text = "Open the shop"

[node name="SandboxButton" type="Button" parent="Center/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Rune sandbox (Atelier IDE)"

[node name="QuitButton" type="Button" parent="Center/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Quit"
