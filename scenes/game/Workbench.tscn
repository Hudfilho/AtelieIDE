[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game/workbench.gd" id="1_workbench"]
[ext_resource type="Script" path="res://scripts/atelier_canvas.gd" id="2_canvas"]
[ext_resource type="Theme" path="res://art/theme/shop_theme.tres" id="3_theme"]

[node name="Workbench" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_workbench")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.065, 0.05, 1)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="OrderBar" type="PanelContainer" parent="Layout"]
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Layout/OrderBar"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Info" type="VBoxContainer" parent="Layout/OrderBar/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="OrderTitle" type="Label" parent="Layout/OrderBar/Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Order"

[node name="SpecLabel" type="Label" parent="Layout/OrderBar/Row/Info"]
unique_name_in_owner = true
layout_mode = 2
text = "Spec"
autowrap_mode = 3

[node name="CasesLabel" type="Label" parent="Layout/OrderBar/Row/Info"]
unique_name_in_owner = true
modulate = Color(0.8, 0.75, 0.62, 1)
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Tests"
autowrap_mode = 3

[node name="ResultLabel" type="Label" parent="Layout/OrderBar/Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Result"
autowrap_mode = 3

[node name="Buttons" type="VBoxContainer" parent="Layout/OrderBar/Row"]
layout_mode = 2
alignment = 1

[node name="DeliverButton" type="Button" parent="Layout/OrderBar/Row/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ApproveStamp"
text = "Deliver scroll"

[node name="AbandonButton" type="Button" parent="Layout/OrderBar/Row/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Give up the order"

[node name="Canvas" type="Control" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_canvas")
game_mode = true
