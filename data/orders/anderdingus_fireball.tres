[ext_resource type="Script" path="res://scripts/game/data/consequence.gd" id="2_consequence"]

[sub_resource type="Resource" id="on_delivered_0"]
script = ExtResource("2_consequence")
delay_days = 1
headline = "NORTHERN CAVES: several structures near Millbrook were damaged by fire overnight. Witnesses report a giggling goblin and a scroll bearing YOUR shop's seal."
ledger_text = "Guild fine: the Millbrook fire"
money = -15
reputation = -4
flag_changes = Dictionary[String, int]({"guild_suspicion": 2, "goblin_armed": 1})

[sub_resource type="Resource" id="on_rejected_0"]
script = ExtResource("2_consequence")
delay_days = 0
flag_changes = Dictionary[String, int]({"goblin_refused": 1})

[resource]
script = ExtResource("1_order")
id = "anderdingus_fireball"
