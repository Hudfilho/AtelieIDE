item = "Scroll of the Waking Hour"
details = "My meditations are long, and I lose count of the hours. Tell me at what hour I will rise, so the monastery keeps my supper warm."
spec = "Print the hour he rises on a 24-hour clock.
READ the hour he sits down from slot 000 and how many hours he meditates from slot 001. After hour 23 comes hour 0, and he may sit for days."
