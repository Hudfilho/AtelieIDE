reputation = -1

[resource]
script = ExtResource("1_order")
id = "elenia_even_bloom"
client_name = "Elenia Valehart"
age = "164"
race = "Elf"
signature = "Elenia Valehart"
portrait = ExtResource("portrait")
portrait_color = Color(0.4, 0.55, 0.35, 1)
greeting = "Good morning! Elves may shop here again, I hope? My lilies need help."
reaction_approved = "Thank you! The lilies will be so glad."
reaction_refused = "Still? The herald said the embargo was over..."
item = "Scroll of Even Bloom"
details = "My three lily beds grow unevenly. Let them share: each bed should reach the average height of the three."
spec = "Print the average height of the three beds, rounded down.
READ the beds from slots 000, 001 and 002."
examples = Array[Dictionary]([{"memory": {0: 4, 1: 6, 2: 11}, "output": ["7"]}])
hidden_tests = Array[Dictionary]([{"memory": {0: 9, 1: 9, 2: 9}, "output": ["9"]}, {"memory": {0: 1, 1: 2, 2: 2}, "output": ["1"]}])
par_runes = 8
reward = 22
on_rejected = Array[ExtResource("2_consequence")]([SubResource("on_rejected_0")])
