[gd_resource type="Resource" script_class="AtelierShopDay" format=3]

[ext_resource type="Script" path="res://scripts/game/data/shop_day.gd" id="1_day"]
[ext_resource type="Script" path="res://scripts/game/data/shop_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/game/data/scroll_order.gd" id="3_order"]
[ext_resource type="Resource" path="res://data/orders/anderdingus_hush.tres" id="o0"]
[ext_resource type="Resource" path="res://data/orders/ketterly_fair_shares.tres" id="o1"]
[ext_resource type="Resource" path="res://data/orders/osric_gentle_forgetting.tres" id="o2"]
[ext_resource type="Resource" path="res://data/orders/guild_inspector_routine.tres" id="o3"]

[sub_resource type="Resource" id="rule_offensive_license"]
script = ExtResource("2_rule")
id = "offensive_license"
text = "Offensive scrolls (fire, lightning, curses) are sold only to licensed Guild members."

[sub_resource type="Resource" id="rule_signature"]
script = ExtResource("2_rule")
id = "signature"
text = "The signature must match the client's name."

[sub_resource type="Resource" id="rule_forbidden_mind"]
script = ExtResource("2_rule")
id = "forbidden_mind"
text = "FORBIDDEN MAGIC: no scroll may alter a person's mind, memory or will."

[resource]
script = ExtResource("1_day")
title = "Day 3 - The Inspection"
intro = "The royal embargo was lifted overnight, but a Guild decree arrived with the dawn: some magic must never be written. Word is that a Guild inspector will visit the shops today.\n\nNew runes arrived as well: division, remainders, and a way to store values in memory."
rules = Array[ExtResource("2_rule")]([SubResource("rule_offensive_license"), SubResource("rule_signature"), SubResource("rule_forbidden_mind")])
runes = PackedStringArray("ORB", "TRIANGLE", "READ", "DIAMOND", "CROSS", "TWIN", "CUP", "MOON", "PLUS", "GT", "WARP_ENDPOINT", "JUMP_IF_TRUE", "SLASH", "SPIRAL", "SQUARE")
orders = Array[ExtResource("3_order")]([ExtResource("o0"), ExtResource("o1"), ExtResource("o2"), ExtResource("o3")])
