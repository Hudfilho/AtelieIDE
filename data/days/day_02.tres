[resource]
script = ExtResource("1_day")
title = "Day 2 - The Embargo"
intro = "A royal messenger nailed a decree to your door at dawn. New runes arrived from the Guild as well: loops are now within your reach."
rules = Array[ExtResource("2_rule")]([ExtResource("rule_offensive_license"), ExtResource("rule_signature"), ExtResource("rule_elf_embargo")])
runes = PackedStringArray("ORB", "TRIANGLE", "READ", "DIAMOND", "CROSS", "TWIN", "CUP", "MOON", "PLUS", "GT", "WARP_ENDPOINT", "JUMP_IF_TRUE")
orders = Array[ExtResource("3_order")]([ExtResource("o0"), ExtResource("o1"), ExtResource("o2"), ExtResource("o3"), ExtResource("o4")])
