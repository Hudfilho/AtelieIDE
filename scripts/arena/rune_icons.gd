static var _cache: Dictionary = {}
static var _atlas_image: Image


static func icon(kind: String) -> Texture2D:
	if _cache.has(kind):
		return _cache[kind]
	var texture: Texture2D = null
	if HAND_DRAWN.has(kind):
		texture = ArenaPixelArt.texture("rune_" + kind, HAND_DRAWN[kind], {"#": Color.WHITE})
	elif Canvas.RUNE_ATLAS_INDEX.has(kind):
		texture = _pixelize(int(Canvas.RUNE_ATLAS_INDEX[kind]))
	_cache[kind] = texture
	return texture


static func icons_for(kinds: Array) -> Dictionary:
	var result := {}
	for kind in kinds:
		var texture := icon(str(kind))
		if texture != null:
			result[str(kind)] = texture
	return result


static func _pixelize(index: int) -> Texture2D:
	if _atlas_image == null:
		_atlas_image = ATLAS.get_image()
		if _atlas_image.is_compressed():
			_atlas_image.decompress()
	var tile := int(Canvas.RUNE_ATLAS_TILE_SIZE)
	var columns := int(Canvas.RUNE_ATLAS_COLUMNS)
	var origin_x := (index % columns) * tile
	var origin_y := (index / columns) * tile
	var block := tile / SIZE
	var out := Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	for y in range(SIZE):
		for x in range(SIZE):
			var coverage := 0.0
			for by in range(block):
				for bx in range(block):
					coverage += _atlas_image.get_pixel(origin_x + x * block + bx, origin_y + y * block + by).a
			if coverage / float(block * block) >= THRESHOLD:
				out.set_pixel(x, y, Color.WHITE)
	return ImageTexture.create_from_image(out)
